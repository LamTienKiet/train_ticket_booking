# Kết nối MySQL cho Prisma
DATABASE_URL="mysql://USER:PASSWORD@localhost:3306/train_booking"
PORT=3001

# Bắt buộc. Sinh bằng: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# true = cho phép POST /payments/confirm (thanh toán giả). KHÔNG bật ở production.
PAYMENT_MOCK_ENABLED=false

# Domain frontend được phép gọi API (phân tách bằng dấu phẩy)
CORS_ORIGINS=http://localhost:3000
# Đặt 1 khi chạy sau nginx/load balancer để rate limit lấy đúng IP
TRUST_PROXY=
