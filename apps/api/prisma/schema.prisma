generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------
// ENUMS
// ---------------------------------------------
enum Role {
  CUSTOMER
  STAFF
  ADMIN
}

enum StatusActiveInactive {
  ACTIVE
  INACTIVE
}

enum UserStatus {
  ACTIVE
  INACTIVE
  BANNED
}

enum TrainStatus {
  ACTIVE
  INACTIVE
  MAINTENANCE
}

enum CoachType {
  SEATING
  SLEEPER
  RESTAURANT
  SERVICE
}

enum TripStatus {
  SCHEDULED
  BOARDING
  DEPARTED
  COMPLETED
  CANCELLED
}

enum PassengerType {
  ADULT
  CHILD
  STUDENT
  SENIOR
  INFANT
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
  EXPIRED
  COMPLETED
}

enum BookingSeatStatus {
  HELD
  CONFIRMED
  CANCELLED
}

enum DiscountType {
  PERCENTAGE
  FIXED
}

enum CouponStatus {
  ACTIVE
  INACTIVE
  EXPIRED
}

enum PaymentProvider {
  MOCK
  VNPAY
  STRIPE
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  REFUNDED
}

enum RefundStatus {
  PENDING
  SUCCESS
  FAILED
}

enum TicketStatus {
  ACTIVE
  USED
  CANCELLED
}

enum BoardingStatus {
  BOARDED
  REJECTED
}

// ---------------------------------------------
// MODELS
// ---------------------------------------------

model Account {
  id           String     @id @default(uuid()) @db.Char(36)
  username     String?    @unique @db.VarChar(50)
  email        String     @unique @db.VarChar(255)
  passwordHash String     @map("password_hash") @db.VarChar(255)
  role         Role       @default(CUSTOMER)
  status       UserStatus @default(ACTIVE)
  lastLoginAt  DateTime?  @map("last_login_at") 
  createdAt    DateTime   @default(now()) @map("created_at") 
  updatedAt    DateTime   @default(now()) @updatedAt @map("updated_at") 

  user            User?
  refreshTokens   RefreshToken[]
  auditLogs       AuditLog[]

  @@map("accounts")
}

model User {
  id        String    @id @default(uuid()) @db.Char(36)
  accountId String    @unique @map("account_id") @db.Char(36)
  fullName  String?   @map("full_name") @db.VarChar(150)
  phone     String?   @db.VarChar(20)
  avatar    String?   @db.VarChar(255)
  birthday  DateTime? @db.Date
  gender    String?   @db.VarChar(20)
  address   String?   @db.VarChar(255)
  createdAt DateTime  @default(now()) @map("created_at") 
  updatedAt DateTime  @default(now()) @updatedAt @map("updated_at") 

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  bookings        Booking[]
  boardingRecords BoardingRecord[]
  reviews         Review[]
  notifications   Notification[]
  statusHistories BookingStatusHistory[]

  @@map("users")
}

model RefreshToken {
  id        String    @id @default(uuid()) @db.Char(36)
  accountId String    @map("account_id") @db.Char(36)
  tokenHash String    @unique @map("token_hash") @db.VarChar(255)
  expiresAt DateTime  @map("expires_at") 
  revokedAt DateTime? @map("revoked_at") 
  createdAt DateTime  @default(now()) @map("created_at") 

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@map("refresh_tokens")
}

model Station {
  id        String               @id @default(uuid()) @db.Char(36)
  code      String               @unique @db.VarChar(20)
  name      String               @db.VarChar(150)
  city      String               @db.VarChar(100)
  address   String?              @db.VarChar(255)
  latitude  Decimal?             @db.Decimal(10, 7)
  longitude Decimal?             @db.Decimal(10, 7)
  status    StatusActiveInactive @default(ACTIVE)
  createdAt DateTime             @default(now()) @map("created_at") 
  updatedAt DateTime             @default(now()) @updatedAt @map("updated_at") 

  originRoutes       Route[]          @relation("RouteOrigin")
  destinationRoutes  Route[]          @relation("RouteDestination")
  routeStations      RouteStation[]
  tripStations       TripStation[]
  bookingSeatsOrigin BookingSeat[]    @relation("BookingSeatOrigin")
  bookingSeatsDest   BookingSeat[]    @relation("BookingSeatDestination")
  boardingRecords    BoardingRecord[]

  @@map("stations")
}

model Route {
  id                    String               @id @default(uuid()) @db.Char(36)
  code                  String               @unique @db.VarChar(30)
  name                  String               @db.VarChar(150)
  originStationId       String               @map("origin_station_id") @db.Char(36)
  destinationStationId  String               @map("destination_station_id") @db.Char(36)
  distanceKm            Decimal?             @map("distance_km") @db.Decimal(8, 2)
  estimatedDurationMins Int?                 @map("estimated_duration_minutes")
  status                StatusActiveInactive @default(ACTIVE)
  createdAt             DateTime             @default(now()) @map("created_at") 
  updatedAt             DateTime             @default(now()) @updatedAt @map("updated_at") 

  originStation      Station @relation("RouteOrigin", fields: [originStationId], references: [id])
  destinationStation Station @relation("RouteDestination", fields: [destinationStationId], references: [id])

  routeStations RouteStation[]
  trips         Trip[]
  fareRules     FareRule[]

  @@map("routes")
}

model RouteStation {
  id                     String @id @default(uuid()) @db.Char(36)
  routeId                String @map("route_id") @db.Char(36)
  stationId              String @map("station_id") @db.Char(36)
  stopOrder              Int    @map("stop_order")
  arrivalOffsetMinutes   Int    @map("arrival_offset_minutes")
  departureOffsetMinutes Int    @map("departure_offset_minutes")

  route   Route   @relation(fields: [routeId], references: [id], onDelete: Cascade)
  station Station @relation(fields: [stationId], references: [id])

  @@unique([routeId, stationId])
  @@unique([routeId, stopOrder])
  @@map("route_stations")
}

model Train {
  id        String      @id @default(uuid()) @db.Char(36)
  code      String      @unique @db.VarChar(20)
  name      String      @db.VarChar(100)
  status    TrainStatus @default(ACTIVE)
  createdAt DateTime    @default(now()) @map("created_at") 
  updatedAt DateTime    @default(now()) @updatedAt @map("updated_at") 

  coaches Coach[]
  trips   Trip[]
  reviews Review[]

  @@map("trains")
}

model SeatType {
  id              String   @id @default(uuid()) @db.Char(36)
  code            String   @unique @db.VarChar(30)
  name            String   @db.VarChar(100)
  description     String?  @db.VarChar(255)
  priceMultiplier Decimal  @default(1.00) @map("price_multiplier") @db.Decimal(5, 2)
  createdAt       DateTime @default(now()) @map("created_at") 

  seats     Seat[]
  fareRules FareRule[]

  @@map("seat_types")
}

model Coach {
  id          String               @id @default(uuid()) @db.Char(36)
  trainId     String               @map("train_id") @db.Char(36)
  coachNumber Int                  @map("coach_number")
  coachType   CoachType            @map("coach_type")
  capacity    Int
  status      StatusActiveInactive @default(ACTIVE)
  createdAt   DateTime             @default(now()) @map("created_at") 

  train Train  @relation(fields: [trainId], references: [id], onDelete: Cascade)
  seats Seat[]

  @@unique([trainId, coachNumber])
  @@map("coaches")
}

model Seat {
  id          String               @id @default(uuid()) @db.Char(36)
  coachId     String               @map("coach_id") @db.Char(36)
  seatTypeId  String               @map("seat_type_id") @db.Char(36)
  seatNumber  String               @map("seat_number") @db.VarChar(20)
  floorNumber Int?                 @map("floor_number")
  position    String?              @db.VarChar(30)
  status      StatusActiveInactive @default(ACTIVE)
  createdAt   DateTime             @default(now()) @map("created_at") 

  coach        Coach         @relation(fields: [coachId], references: [id], onDelete: Cascade)
  seatType     SeatType      @relation(fields: [seatTypeId], references: [id])
  bookingSeats BookingSeat[]

  @@unique([coachId, seatNumber])
  @@map("seats")
}

model Trip {
  id            String     @id @default(uuid()) @db.Char(36)
  tripCode      String     @unique @map("trip_code") @db.VarChar(50)
  routeId       String     @map("route_id") @db.Char(36)
  trainId       String     @map("train_id") @db.Char(36)
  departureTime DateTime   @map("departure_time") 
  arrivalTime   DateTime   @map("arrival_time") 
  status        TripStatus @default(SCHEDULED)
  createdAt     DateTime   @default(now()) @map("created_at") 
  updatedAt     DateTime   @default(now()) @updatedAt @map("updated_at") 

  route        Route         @relation(fields: [routeId], references: [id])
  train        Train         @relation(fields: [trainId], references: [id])
  tripStations TripStation[]
  bookings     Booking[]

  @@map("trips")
}

model TripStation {
  id            String    @id @default(uuid()) @db.Char(36)
  tripId        String    @map("trip_id") @db.Char(36)
  stationId     String    @map("station_id") @db.Char(36)
  stopOrder     Int       @map("stop_order")
  arrivalTime   DateTime? @map("arrival_time") 
  departureTime DateTime? @map("departure_time") 
  createdAt     DateTime  @default(now()) @map("created_at") 

  trip    Trip    @relation(fields: [tripId], references: [id], onDelete: Cascade)
  station Station @relation(fields: [stationId], references: [id])

  @@unique([tripId, stationId])
  @@unique([tripId, stopOrder])
  @@map("trip_stations")
}

model FareRule {
  id            String               @id @default(uuid()) @db.Char(36)
  routeId       String               @map("route_id") @db.Char(36)
  seatTypeId    String               @map("seat_type_id") @db.Char(36)
  basePrice     Decimal              @map("base_price") @db.Decimal(12, 2)
  minDistanceKm Decimal?             @map("min_distance_km") @db.Decimal(8, 2)
  maxDistanceKm Decimal?             @map("max_distance_km") @db.Decimal(8, 2)
  effectiveFrom DateTime             @map("effective_from") 
  effectiveTo   DateTime?            @map("effective_to") 
  status        StatusActiveInactive @default(ACTIVE)
  createdAt     DateTime             @default(now()) @map("created_at") 

  route          Route               @relation(fields: [routeId], references: [id])
  seatType       SeatType            @relation(fields: [seatTypeId], references: [id])
  passengerFares PassengerFareRule[]

  @@map("fare_rules")
}

model PassengerFareRule {
  id              String        @id @default(uuid()) @db.Char(36)
  fareRuleId      String        @map("fare_rule_id") @db.Char(36)
  passengerType   PassengerType @map("passenger_type")
  discountPercent Decimal       @default(0) @map("discount_percent") @db.Decimal(5, 2)

  fareRule FareRule @relation(fields: [fareRuleId], references: [id], onDelete: Cascade)

  @@unique([fareRuleId, passengerType])
  @@map("passenger_fare_rules")
}

model Booking {
  id             String        @id @default(uuid()) @db.Char(36)
  bookingCode    String        @unique @map("booking_code") @db.VarChar(30)
  userId         String?       @map("user_id") @db.Char(36)
  tripId         String        @map("trip_id") @db.Char(36)
  contactName    String?       @map("contact_name") @db.VarChar(150)
  contactPhone   String?       @map("contact_phone") @db.VarChar(20)
  contactEmail   String?       @map("contact_email") @db.VarChar(255)
  subtotalAmount Decimal       @default(0) @map("subtotal_amount") @db.Decimal(12, 2)
  discountAmount Decimal       @default(0) @map("discount_amount") @db.Decimal(12, 2)
  totalAmount    Decimal       @default(0) @map("total_amount") @db.Decimal(12, 2)
  status         BookingStatus @default(PENDING)
  expiresAt      DateTime?     @map("expires_at") 
  confirmedAt    DateTime?     @map("confirmed_at") 
  cancelledAt    DateTime?     @map("cancelled_at") 
  completedAt    DateTime?     @map("completed_at") 
  createdAt      DateTime      @default(now()) @map("created_at") 
  updatedAt      DateTime      @default(now()) @updatedAt @map("updated_at") 

  user User? @relation(fields: [userId], references: [id])
  trip Trip  @relation(fields: [tripId], references: [id])

  passengers      Passenger[]
  bookingSeats    BookingSeat[]
  bookingCoupons  BookingCoupon[]
  payment         Payment?
  reviews         Review[]
  statusHistories BookingStatusHistory[]

  @@map("bookings")
}

model Passenger {
  id            String        @id @default(uuid()) @db.Char(36)
  bookingId     String        @map("booking_id") @db.Char(36)
  fullName      String        @map("full_name") @db.VarChar(150)
  idNumber      String        @map("id_number") @db.VarChar(50)
  dateOfBirth   DateTime?     @map("date_of_birth") @db.Date
  phone         String?       @db.VarChar(20)
  email         String?       @db.VarChar(255)
  passengerType PassengerType @default(ADULT) @map("passenger_type")
  createdAt     DateTime      @default(now()) @map("created_at") 

  booking      Booking       @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  bookingSeats BookingSeat[]

  @@map("passengers")
}

model BookingSeat {
  id                   String            @id @default(uuid()) @db.Char(36)
  bookingId            String            @map("booking_id") @db.Char(36)
  passengerId          String            @map("passenger_id") @db.Char(36)
  seatId               String            @map("seat_id") @db.Char(36)
  originStationId      String            @map("origin_station_id") @db.Char(36)
  destinationStationId String            @map("destination_station_id") @db.Char(36)
  price                Decimal           @db.Decimal(12, 2)
  status               BookingSeatStatus @default(HELD)
  createdAt            DateTime          @default(now()) @map("created_at") 

  booking            Booking   @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  passenger          Passenger @relation(fields: [passengerId], references: [id])
  seat               Seat      @relation(fields: [seatId], references: [id])
  originStation      Station   @relation("BookingSeatOrigin", fields: [originStationId], references: [id])
  destinationStation Station   @relation("BookingSeatDestination", fields: [destinationStationId], references: [id])

  ticketIssue TicketIssue?

  @@map("booking_seats")
}

model Coupon {
  id                String       @id @default(uuid()) @db.Char(36)
  code              String       @unique @db.VarChar(50)
  description       String?      @db.VarChar(255)
  discountType      DiscountType @map("discount_type")
  discountValue     Decimal      @map("discount_value") @db.Decimal(12, 2)
  minOrderAmount    Decimal      @default(0) @map("min_order_amount") @db.Decimal(12, 2)
  maxDiscountAmount Decimal?     @map("max_discount_amount") @db.Decimal(12, 2)
  usageLimit        Int?         @map("usage_limit")
  usedCount         Int          @default(0) @map("used_count")
  startsAt          DateTime     @map("starts_at") 
  expiresAt         DateTime     @map("expires_at") 
  status            CouponStatus @default(ACTIVE)
  createdAt         DateTime     @default(now()) @map("created_at") 

  bookingCoupons BookingCoupon[]

  @@map("coupons")
}

model BookingCoupon {
  id             String   @id @default(uuid()) @db.Char(36)
  bookingId      String   @map("booking_id") @db.Char(36)
  couponId       String   @map("coupon_id") @db.Char(36)
  discountAmount Decimal  @map("discount_amount") @db.Decimal(12, 2)
  createdAt      DateTime @default(now()) @map("created_at") 

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  coupon  Coupon  @relation(fields: [couponId], references: [id])

  @@unique([bookingId, couponId])
  @@map("booking_coupons")
}

model Payment {
  id             String          @id @default(uuid()) @db.Char(36)
  bookingId      String          @unique @map("booking_id") @db.Char(36)
  paymentCode    String          @unique @map("payment_code") @db.VarChar(50)
  provider       PaymentProvider @default(MOCK)
  paymentMethod  String?         @map("payment_method") @db.VarChar(50)
  amount         Decimal         @db.Decimal(12, 2)
  status         PaymentStatus   @default(PENDING)
  transactionId  String?         @map("transaction_id") @db.VarChar(100)
  idempotencyKey String          @unique @map("idempotency_key") @db.VarChar(100)
  paidAt         DateTime?       @map("paid_at") 
  createdAt      DateTime        @default(now()) @map("created_at") 
  updatedAt      DateTime        @default(now()) @updatedAt @map("updated_at") 

  booking Booking  @relation(fields: [bookingId], references: [id])
  refunds Refund[]

  @@map("payments")
}

model Refund {
  id               String       @id @default(uuid()) @db.Char(36)
  paymentId        String       @map("payment_id") @db.Char(36)
  amount           Decimal      @db.Decimal(12, 2)
  reason           String?      @db.VarChar(255)
  status           RefundStatus @default(PENDING)
  providerRefundId String?      @map("provider_refund_id") @db.VarChar(100)
  createdAt        DateTime     @default(now()) @map("created_at") 
  processedAt      DateTime?    @map("processed_at") 

  payment Payment @relation(fields: [paymentId], references: [id])

  @@map("refunds")
}

model TicketIssue {
  id            String       @id @default(uuid()) @db.Char(36)
  bookingSeatId String       @unique @map("booking_seat_id") @db.Char(36)
  ticketNumber  String       @unique @map("ticket_number") @db.VarChar(50)
  qrCode        String       @unique @map("qr_code") @db.VarChar(255)
  issuedAt      DateTime     @default(now()) @map("issued_at") 
  status        TicketStatus @default(ACTIVE)
  usedAt        DateTime?    @map("used_at") 

  bookingSeat     BookingSeat      @relation(fields: [bookingSeatId], references: [id])
  boardingRecords BoardingRecord[]

  @@map("ticket_issues")
}

model BoardingRecord {
  id        String         @id @default(uuid()) @db.Char(36)
  ticketId  String         @map("ticket_id") @db.Char(36)
  stationId String         @map("station_id") @db.Char(36)
  checkedBy String?        @map("checked_by") @db.Char(36)
  checkedAt DateTime       @default(now()) @map("checked_at") 
  status    BoardingStatus
  note      String?        @db.VarChar(255)

  ticket  TicketIssue @relation(fields: [ticketId], references: [id])
  station Station     @relation(fields: [stationId], references: [id])
  checker User?       @relation(fields: [checkedBy], references: [id])

  @@map("boarding_records")
}

model Review {
  id        String   @id @default(uuid()) @db.Char(36)
  userId    String   @map("user_id") @db.Char(36)
  bookingId String   @map("booking_id") @db.Char(36)
  trainId   String   @map("train_id") @db.Char(36)
  rating    Int      @db.TinyInt
  comment   String?  @db.Text
  createdAt DateTime @default(now()) @map("created_at") 
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") 

  user    User    @relation(fields: [userId], references: [id])
  booking Booking @relation(fields: [bookingId], references: [id])
  train   Train   @relation(fields: [trainId], references: [id])

  @@unique([userId, bookingId])
  @@map("reviews")
}

model Notification {
  id        String    @id @default(uuid()) @db.Char(36)
  userId    String    @map("user_id") @db.Char(36)
  type      String    @db.VarChar(50)
  title     String    @db.VarChar(200)
  message   String    @db.Text
  isRead    Boolean   @default(false) @map("is_read")
  readAt    DateTime? @map("read_at") 
  createdAt DateTime  @default(now()) @map("created_at") 

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notifications")
}

model AuditLog {
  id         String   @id @default(uuid()) @db.Char(36)
  accountId  String?  @map("account_id") @db.Char(36)
  action     String   @db.VarChar(100)
  entityType String   @map("entity_type") @db.VarChar(50)
  entityId   String?  @map("entity_id") @db.Char(36)
  oldData    Json?    @map("old_data")
  newData    Json?    @map("new_data")
  ipAddress  String?  @map("ip_address") @db.VarChar(45)
  createdAt  DateTime @default(now()) @map("created_at") 

  account Account? @relation(fields: [accountId], references: [id], onDelete: SetNull)

  @@map("audit_logs")
}

model BookingStatusHistory {
  id        String         @id @default(uuid()) @db.Char(36)
  bookingId String         @map("booking_id") @db.Char(36)
  oldStatus BookingStatus? @map("old_status")
  newStatus BookingStatus  @map("new_status")
  changedBy String?        @map("changed_by") @db.Char(36)
  reason    String?        @db.VarChar(255)
  createdAt DateTime       @default(now()) @map("created_at") 

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  user    User?   @relation(fields: [changedBy], references: [id], onDelete: SetNull)

  @@map("booking_status_histories")
}
