# Kết nối MySQL cho Prisma
DATABASE_URL="mysql://USER:PASSWORD@localhost:3306/train_booking"
PORT=3001

# Bắt buộc. Sinh bằng: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# true = cho phép POST /payments/confirm (thanh toán giả). KHÔNG bật ở production.
PAYMENT_MOCK_ENABLED=false

# Domain frontend được phép gọi API (phân tách bằng dấu phẩy)
CORS_ORIGINS=http://localhost:3000
# Đặt 1 khi chạy sau nginx/load balancer để rate limit lấy đúng IP
TRUST_PROXY=

# Gửi email cho khách (đặt vé, hủy, hết hạn, chuyến bị hủy) qua Gmail.
# MAIL_PASS là "Mật khẩu ứng dụng" 16 ký tự (Google Account → Bảo mật → Xác minh 2 bước → Mật khẩu ứng dụng),
# KHÔNG phải mật khẩu Gmail. Để trống thì API vẫn chạy, chỉ không gửi mail.
MAIL_USER=
MAIL_PASS=
# Tên người gửi hiển thị (tùy chọn)
MAIL_FROM="LionRail <your.account@gmail.com>"
# Địa chỉ web để gắn link "Tra cứu vé" trong email
WEB_URL=http://localhost:3000
